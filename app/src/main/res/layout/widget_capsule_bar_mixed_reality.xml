<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_capsule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Exact Floating Liquid-Glass Capsule matching TopModeSegmentedPill + BottomControlBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/widget_capsule_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/widget_capsule_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_round" />

        <!-- Segmented Mode Pill: MR | AR | Object -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_segmented_shell_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/widget_capsule_tab_mr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="MR"
                android:textColor="#B3CAD5E2"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_capsule_tab_ar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="AR"
                android:textColor="#B3CAD5E2"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_capsule_tab_object"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:background="@drawable/widget_pill_selected_bg"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Object"
                android:textColor="#FFFFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_capsule_open_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_dark_bg"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Open"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_capsule_live_orb"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_orb_rec_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
