<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Strip: App Emblem + Unified MR | AR | Object Segmented Glass Pill -->
    <LinearLayout
        android:id="@+id/widget_studio_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/widget_brand_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Top Segmented Pill matching MRMainScreen TopModeSegmentedPill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/widget_segmented_shell_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2.5dp">

            <TextView
                android:id="@+id/widget_studio_tab_mr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="MR"
                android:textColor="#B3CAD5E2"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_studio_tab_ar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="AR"
                android:textColor="#B3CAD5E2"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_studio_tab_object"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/widget_pill_selected_bg"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="Object"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Frosted Inner Glass Model Carousel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/widget_btn_prev_model"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_circle_btn_bg"
            android:contentDescription="@string/widget_prev_model_cd"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_chevron_left" />

        <LinearLayout
            android:id="@+id/widget_model_showcase_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_active_model_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Vision Headset"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_active_model_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="1 / 5 • Mixed Reality Spatial Visor"
                android:textColor="#B3CAD5E2"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_next_model"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_circle_btn_bg"
            android:contentDescription="@string/widget_next_model_cd"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_chevron_right" />
    </LinearLayout>

    <!-- Unified Bottom Action Capsule matching BottomControlBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_segmented_shell_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp">

        <LinearLayout
            android:id="@+id/widget_action_object"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_dark_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_action_3d"
                android:src="@drawable/ic_widget_cube" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="3D"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Glowing Red Central Orb echoing BottomControlBar REC orb -->
        <LinearLayout
            android:id="@+id/widget_action_ar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_orb_rec_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR"
                android:textColor="#FFFFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_action_mr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_dark_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_action_mr"
                android:src="@drawable/ic_widget_mr" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MR"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_action_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_dark_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_action_open"
                android:src="@drawable/ic_widget_open" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Open"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
