<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#33FFFFFF"
                        android:startColor="#73FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#D9101014"
                        android:startColor="#CC242429"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
