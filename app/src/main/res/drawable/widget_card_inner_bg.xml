<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#29FFFFFF"
                android:startColor="#4DFFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D90D0D10"
                android:startColor="#CC1D1D22"
                android:type="linear" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
