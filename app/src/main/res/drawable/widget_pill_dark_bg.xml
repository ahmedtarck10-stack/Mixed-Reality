<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#29FFFFFF"
                        android:startColor="#52FFFFFF"
                        android:type="linear" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#D90E0E11"
                        android:startColor="#CC1C1C21"
                        android:type="linear" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
